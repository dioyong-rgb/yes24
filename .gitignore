# ==============================================================================
# [YES24 프로젝트] Git 버전 관리 제외 파일 설정 (.gitignore)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. 파이썬(Python) 관련 캐시 및 컴파일 파일
# (파이썬이 코드를 실행할 때 자동으로 만드는 임시 파일들로, 공유할 필요가 없습니다)
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage
htmlcov/

# ------------------------------------------------------------------------------
# 2. 파이썬 가상환경 (Virtual Environment)
# (패키지 설치 폴더는 용량이 매우 크고 각자 환경에서 재설치하므로 제외합니다)
# ------------------------------------------------------------------------------
.venv/
venv/
env/
ENV/

# ------------------------------------------------------------------------------
# 3. 노드(Node.js) 관련 파일
# (Node.js 라이브러리 설치 폴더 및 실행 로그 파일)
# ------------------------------------------------------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ------------------------------------------------------------------------------
# 4. 보안 및 환경 변수 설정 파일 (중요!)
# (API Key, 비밀번호, 개인 설정값이 들어가므로 절대로 Git에 올리면 안 됩니다)
# ------------------------------------------------------------------------------
.env
.env.local
.env.*.local
*.secret
*.pem

# ------------------------------------------------------------------------------
# 5. 크롤링 및 실행 로그(Log) / 임시 파일
# (크롤러나 스크립트 실행 중 기록되는 로그 파일)
# ------------------------------------------------------------------------------
*.log
temp/
tmp/

# ------------------------------------------------------------------------------
# 6. 운영체제(OS) 및 IDE(에디터) 설정 파일
# (사용자 개인 컴퓨터나 에디터 환경 설정이므로 협업 시 충돌 방지를 위해 제외합니다)
# ------------------------------------------------------------------------------
# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/

# macOS
.DS_Store
.AppleDouble
.LSOverride

# VS Code / JetBrains / PyCharm
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.sublime-project
*.sublime-workspace

# ------------------------------------------------------------------------------
# 7. 생성된 대용량 산출물 (선택 사항)
# (스크립트 실행으로 언제든 다시 생성할 수 있는 대용량 보고서/프레젠테이션 파일)
# ※ 만약 최종 결과물 문서를 Git에 올려서 백업/공유하고 싶다면 앞의 '#'을 붙여 주석 처리하세요.
# ------------------------------------------------------------------------------
# reports/*.pptx
# reports/*.docx
# reports/*.xlsx
# YES24_Bestseller_EDA_Presentation.pptx
reports/
docs/
